// DEAR Inventory - schema.prisma (MySQL)
// Baseado no Documento de Requisitos v1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------

enum Perfil {
  ADMIN
  GERENTE
  FINANCEIRO
}

// CONCLUIDA = movimentação válida | ESTORNADA = cancelada por estorno (nunca se apaga)
// PENDENTE = saída aguardando liberação do gerente (RN-03, a validar com o cliente)
enum StatusMovimentacao {
  PENDENTE
  CONCLUIDA
  ESTORNADA
}

enum TipoSaida {
  VENDA
  DESCARTE
  PERDA
  DEVOLUCAO
  AJUSTE
}

enum SituacaoDespesa {
  PENDENTE
  PAGA
}

enum TipoAlerta {
  ESTOQUE_BAIXO
  PRODUTO_VENCENDO
  PRODUTO_VENCIDO
  COBRANCA_VENCENDO
  COBRANCA_VENCIDA
}

// ---------------------------------------------------------------
// USUÁRIOS (RF-01 a RF-06) - criados somente pelo ADMIN
// ---------------------------------------------------------------

model Usuario {
  id             Int       @id @default(autoincrement())
  nome           String    @db.VarChar(120)
  cargo          String    @db.VarChar(80)
  login          String    @unique @db.VarChar(60)
  senhaHash      String    @map("senha_hash") @db.VarChar(100) // bcrypt
  perfil         Perfil
  ativo          Boolean   @default(true)
  tentativasLogin Int      @default(0) @map("tentativas_login")
  bloqueadoAte   DateTime? @map("bloqueado_ate")
  ultimoLogin    DateTime? @map("ultimo_login")
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  entradas             Entrada[]   @relation("EntradaUsuario")
  entradasEstornadas   Entrada[]   @relation("EntradaEstornadaPor")
  saidas               Saida[]     @relation("SaidaUsuario")
  saidasAutorizadas    Saida[]     @relation("SaidaAutorizadaPor")
  saidasEstornadas     Saida[]     @relation("SaidaEstornadaPor")
  despesas             Despesa[]
  auditorias           Auditoria[]

  @@map("usuarios")
}

// ---------------------------------------------------------------
// CATEGORIAS E PRODUTOS (RF-07 a RF-13)
// ---------------------------------------------------------------

model Categoria {
  id        Int       @id @default(autoincrement())
  nome      String    @unique @db.VarChar(80)
  descricao String?   @db.VarChar(255)
  ativa     Boolean   @default(true)
  criadaEm  DateTime  @default(now()) @map("criada_em")

  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id               Int      @id @default(autoincrement())
  codigo           String   @unique @db.VarChar(50) // evita cadastro duplicado (RN-02)
  nome             String   @db.VarChar(150)
  descricao        String?  @db.VarChar(255)
  categoriaId      Int      @map("categoria_id")
  unidade          String   @default("UN") @db.VarChar(10) // UN, KG, CX, FD...
  custo            Decimal  @default(0) @db.Decimal(12, 2)
  precoVenda       Decimal  @default(0) @map("preco_venda") @db.Decimal(12, 2)
  estoqueMinimo    Decimal  @default(0) @map("estoque_minimo") @db.Decimal(12, 3)
  estoqueAtual     Decimal  @default(0) @map("estoque_atual") @db.Decimal(12, 3) // saldo em tempo real
  controlaValidade Boolean  @default(false) @map("controla_validade")
  fotoUrl          String?  @map("foto_url") @db.VarChar(255)
  ativo            Boolean  @default(true) // produto com histórico só é desativado (RN-11)
  criadoEm         DateTime @default(now()) @map("criado_em")
  atualizadoEm     DateTime @updatedAt @map("atualizado_em")

  categoria Categoria @relation(fields: [categoriaId], references: [id])
  entradas  Entrada[]
  saidas    Saida[]
  alertas   Alerta[]

  @@index([nome])
  @@index([categoriaId])
  @@map("produtos")
}

// ---------------------------------------------------------------
// MOVIMENTAÇÕES DE ESTOQUE (RF-14 a RF-24)
// ---------------------------------------------------------------

model Entrada {
  id            Int                @id @default(autoincrement())
  produtoId     Int                @map("produto_id")
  quantidade    Decimal            @db.Decimal(12, 3)
  custoUnitario Decimal            @map("custo_unitario") @db.Decimal(12, 2)
  lote          String?            @db.VarChar(50)
  validade      DateTime?          @db.Date
  dataEntrada   DateTime           @default(now()) @map("data_entrada")
  usuarioId     Int                @map("usuario_id")
  observacao    String?            @db.VarChar(255)
  status        StatusMovimentacao @default(CONCLUIDA)

  // estorno (RN-10): nunca apagar, apenas marcar
  estornadaEm          DateTime? @map("estornada_em")
  estornadaPorId       Int?      @map("estornada_por_id")
  justificativaEstorno String?   @map("justificativa_estorno") @db.VarChar(255)

  produto      Produto  @relation(fields: [produtoId], references: [id])
  usuario      Usuario  @relation("EntradaUsuario", fields: [usuarioId], references: [id])
  estornadaPor Usuario? @relation("EntradaEstornadaPor", fields: [estornadaPorId], references: [id])

  @@index([produtoId, dataEntrada])
  @@index([validade])
  @@map("entradas")
}

model Saida {
  id            Int                @id @default(autoincrement())
  produtoId     Int                @map("produto_id")
  quantidade    Decimal            @db.Decimal(12, 3)
  valorUnitario Decimal            @map("valor_unitario") @db.Decimal(12, 2) // preço de saída
  custoUnitario Decimal            @map("custo_unitario") @db.Decimal(12, 2) // custo no momento (base do lucro)
  tipo          TipoSaida          @default(VENDA)
  dataSaida     DateTime           @default(now()) @map("data_saida")
  usuarioId     Int                @map("usuario_id")
  autorizadaPorId Int?             @map("autorizada_por_id") // gerente (RN-03)
  motivo        String?            @db.VarChar(255)
  status        StatusMovimentacao @default(CONCLUIDA)

  estornadaEm          DateTime? @map("estornada_em")
  estornadaPorId       Int?      @map("estornada_por_id")
  justificativaEstorno String?   @map("justificativa_estorno") @db.VarChar(255)

  produto        Produto  @relation(fields: [produtoId], references: [id])
  usuario        Usuario  @relation("SaidaUsuario", fields: [usuarioId], references: [id])
  autorizadaPor  Usuario? @relation("SaidaAutorizadaPor", fields: [autorizadaPorId], references: [id])
  estornadaPor   Usuario? @relation("SaidaEstornadaPor", fields: [estornadaPorId], references: [id])

  @@index([produtoId, dataSaida])
  @@index([dataSaida])
  @@map("saidas")
}

// ---------------------------------------------------------------
// FINANCEIRO (RF-25 a RF-31)
// ---------------------------------------------------------------

model Despesa {
  id             Int             @id @default(autoincrement())
  descricao      String          @db.VarChar(150)
  categoria      String?         @db.VarChar(60) // aluguel, fornecedores, impostos...
  valor          Decimal         @db.Decimal(12, 2)
  dataLancamento DateTime        @default(now()) @map("data_lancamento")
  vencimento     DateTime        @db.Date
  situacao       SituacaoDespesa @default(PENDENTE)
  dataPagamento  DateTime?       @map("data_pagamento")
  usuarioId      Int             @map("usuario_id")

  usuario Usuario  @relation(fields: [usuarioId], references: [id])
  alertas Alerta[]

  @@index([vencimento, situacao])
  @@map("despesas")
}

// ---------------------------------------------------------------
// ALERTAS (RF-41 a RF-44)
// ---------------------------------------------------------------

model Alerta {
  id        Int        @id @default(autoincrement())
  tipo      TipoAlerta
  mensagem  String     @db.VarChar(255)
  produtoId Int?       @map("produto_id")
  despesaId Int?       @map("despesa_id")
  lido      Boolean    @default(false)
  criadoEm  DateTime   @default(now()) @map("criado_em")

  produto Produto? @relation(fields: [produtoId], references: [id])
  despesa Despesa? @relation(fields: [despesaId], references: [id])

  @@index([lido, criadoEm])
  @@map("alertas")
}

// ---------------------------------------------------------------
// AUDITORIA (RF-46, RNF-06)
// ---------------------------------------------------------------

model Auditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int?     @map("usuario_id")
  acao      String   @db.VarChar(60) // LOGIN, CRIAR_ENTRADA, CRIAR_SAIDA, AUTORIZAR_SAIDA, ESTORNO...
  entidade  String   @db.VarChar(60)
  entidadeId Int?    @map("entidade_id")
  detalhes  Json?
  ip        String?  @db.VarChar(45)
  criadoEm  DateTime @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, criadoEm])
  @@index([entidade, entidadeId])
  @@map("auditoria")
}

// ---------------------------------------------------------------
// CONFIGURAÇÕES (parâmetros a definir com o cliente, seção 6.1)
// ex.: DIAS_ALERTA_VENCIMENTO = 30
// ---------------------------------------------------------------

model Configuracao {
  chave String @id @db.VarChar(60)
  valor String @db.VarChar(255)

  @@map("configuracoes")
}
